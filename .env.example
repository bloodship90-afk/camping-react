# Firebase Web Config (템플릿)
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채우세요.
# .env.local 은 git 에 올라가지 않습니다 (.gitignore 포함).
# 값 출처: Firebase 콘솔 → 프로젝트 설정 → 일반 → 웹 앱 → SDK 설정 및 구성

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 개발 서버 전용. 실제 데이터 없이 화면을 확인하려면 true로 설정하세요.
VITE_DEMO_MODE=false
# 별도로 실행 중인 Database Emulator(127.0.0.1:9000)를 사용할 때만 true
VITE_USE_FIREBASE_EMULATOR=false
